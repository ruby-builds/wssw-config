#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define A1 0
#define A2 1
#define NUMNAV 2
#define SYM 3
#define FUN 4

/ {
    combos {
        compatible = "zmk,combos";
        /* Combos temporarily disabled for debug
        combo_tab { key-positions = <0 1>; bindings = <&kp TAB>; layers = <A1>; };
        ...
        */
    };

    behaviors {
        /* Hold-Tap Modifiers */
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
        };
        
        hl: hm_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_L";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <3 4 5 10 11 12 13 16>; /* Right Hand + RThumbs (16) */
        };

        hr: hm_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_R";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            bindings = <&kp>, <&kp>;
            hold-trigger-key-positions = <0 1 2 6 7 8 9 14 15>; /* Left Hand + LThumbs (14,15) */
        };
    };

    keymap {
        compatible = "zmk,keymap";

        /*
         * A1 (Base)
         * R(G) T(A) S(S) | H(S) A(A) I(G)
         * N(C) L    D    Y   | M    O    U    E(C)
         *      SL(A2)        LT(SYM, SPC)
         */
        a1_layer {
            label = "A1";
            bindings = <
                &hl LGUI R      &hl LALT T      &hl LSHIFT S      &hr RSHIFT H    &hr RALT A      &hr RGUI I
                &hl LCTRL N     &kp L           &kp D             &kp Y           &kp M           &kp O           &kp U           &hr RCTRL E
                                                &sl A2            &sl A2          &lt SYM SPACE   &lt SYM SPACE
            >;
        };

        /*
         * A2
         * W B C | F Z .
         * P X V G | K Q , J
         *   NUM      trans
         */
        a2_layer {
            label = "A2";
            bindings = <
                &kp W           &kp B           &kp C             &kp F           &kp Z           &kp DOT
                &kp P           &kp X           &kp V             &kp G           &kp K           &kp Q           &kp COMMA       &kp J
                                                &mo NUMNAV        &mo NUMNAV      &trans          &trans
            >;
        };

        /*
         * NUMNAV
         * 1 2 3 | Left Up Down
         * 0 4 5 6 | Home End _ Right
         */
        numnav_layer {
            label = "NUMNAV";
            bindings = <
                &kp N1          &kp N2          &kp N3            &kp LEFT        &kp UP          &kp DOWN
                &kp N0          &kp N4          &kp N5            &kp N6          &kp HOME        &kp END         &none           &kp RIGHT
                                                &trans            &trans          &trans          &trans
            >;
        };

        /*
         * SYM
         * @ # $ | ^ & *
         * ! - _ % | = + \ |
         */
        sym_layer {
            label = "SYM";
            bindings = <
                &kp AT          &kp HASH        &kp DOLLAR        &kp CARET       &kp AMPERSAND   &kp ASTERISK
                &kp EXCL        &kp MINUS       &kp UNDER         &kp PRCNT       &kp EQUAL       &kp PLUS        &kp BSLH        &kp PIPE
                                                &trans            &trans          &trans          &trans
            >;
        };

        /*
         * FUN
         * F1 F2 F3 | F7 F8 F9
         * Boot F4 F5 F6 | F10 F11 F12
         */
        fun_layer {
            label = "FUN";
            bindings = <
                &kp F1          &kp F2          &kp F3            &kp F7          &kp F8          &kp F9
                &none           &kp F4          &kp F5            &kp F6          &kp F10         &kp F11         &kp F12         &trans
                                                &trans            &trans          &trans          &trans
            >;
        };
    };
};
